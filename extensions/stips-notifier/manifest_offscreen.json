{
  "manifest_version": 3,
  "name": "Stips Notifie (Offscreen Test)",
  "version": "11.0",
  "description": "התראות פוש חכמות - גרסת ניסוי עם Offscreen Document",
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "offscreen",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "*://stips.co.il/*",
    "*://*.stips.co.il/*"
  ],
  "background": {
    "service_worker": "background_offscreen.js"
  },
  "action": {
    "default_title": "Stips Enhancer Settings",
    "default_icon": {
      "48": "icon48.png"
    },
    "default_popup": "options.html"
  },
  "icons": {
    "48": "icon48.png"
  }
}