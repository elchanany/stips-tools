{
  "manifest_version": 3,
  "name": "Stips Download",
  "version": "1.0.0",
  "description": "הורדת שיחות Stips לארכיון פרטי, מהיר ונוח לחיפוש.",
  "permissions": [
    "storage",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "*://stips.co.il/*",
    "*://*.stips.co.il/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://stips.co.il/*",
        "*://*.stips.co.il/*"
      ],
      "js": [
        "core/date_utils.js",
        "core/storage.js",
        "core/api_client.js",
        "core/archive_template.js",
        "core/exporter.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Stips Download",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
